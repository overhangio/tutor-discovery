# Run all steps in a single Django process: each `./manage.py` call boots Django
# from scratch, which takes several seconds.
cat <<'TUTOR_DISCOVERY_LMS_INIT_EOF' > /tmp/discovery_lms_init.py
import json

from django.contrib.sites.models import Site
from django.core.management import call_command
from openedx.core.djangoapps.programs.models import ProgramsApiConfig

ProgramsApiConfig.current().enabled or ProgramsApiConfig.objects.create(marketing_path="/programs", enabled=True)

# There's a bug in Open edX where if you try to use create_or_update_site_configuration, if the site exists but doesn't
# have the name, it fails. First let's ensure all sites have names.
# The same approach is used in settheme command in tutor.
name_max_length = Site._meta.get_field("name").max_length
for site in Site.objects.filter(name=""):
    site.name = site.domain[:name_max_length]
    site.save()
    print(f"Fixed site name for {site.domain}")

# The COURSE_CATALOG_API_URL used to be stored in a setting, but is now a site
# configuration -- which means that it takes different values for different
# sites. This is important because the programs and courses returned for each
# site will differ.
call_command(
    "create_or_update_site_configuration",
    "{{ LMS_HOST }}",
    "--configuration",
    json.dumps({"COURSE_CATALOG_API_URL": "{% if ENABLE_HTTPS %}https{% else %}http{% endif %}://{{ DISCOVERY_HOST }}/api/v1"}),
    "--enabled",
)
call_command(
    "create_or_update_site_configuration",
    "{{ LMS_HOST }}:8000",
    "--configuration",
    json.dumps({"COURSE_CATALOG_API_URL": "http://{{ DISCOVERY_HOST }}:8381/api/v1"}),
    "--enabled",
)
TUTOR_DISCOVERY_LMS_INIT_EOF
PYTHONUNBUFFERED=1 ./manage.py lms shell -c "$(cat /tmp/discovery_lms_init.py)"
